{
  "name": "prezi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A local desk for animated presentations.",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "yarn scene:prepare && yarn scene:runtime && electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build && yarn scene:prepare && yarn scene:runtime",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.cjs --max-warnings 0 --report-unused-disable-directives",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "yarn scene:prepare && vitest run",
    "test:watch": "vitest",
    "test:electron": "playwright test",
    "verify": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build",
    "package:make": "yarn build && electron-builder --publish never",
    "package:test": "playwright test --config playwright.packaged.config.ts tests/packaged/desktop.test.ts tests/packaged/scenes.test.ts",
    "package:update:test": "playwright test --config playwright.packaged.config.ts tests/packaged/updates.test.ts",
    "release:verify": "node --experimental-strip-types scripts/verify-release.ts",
    "scene:types": "node --experimental-strip-types scripts/prepare-scene-types.ts",
    "scene:prepare": "yarn scene:types && node --experimental-strip-types scripts/build-scene-worker.ts",
    "scene:runtime": "vite build --config scene-runtime.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@remotion/player": "4.0.539",
    "@zip.js/zip.js": "^2.24.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "image-size": "2.0.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.539",
    "semver": "7.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.7.1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "js-yaml": "4.3.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "Alexander Wanyoike",
  "homepage": "https://github.com/alexanderwanyoike/prezi",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexanderwanyoike/prezi.git"
  },
  "desktopName": "prezi"
}
